[settings]
path.include:core = /usr/local/include/
path.lib:core = /usr/local/lib/
lib:core = yuni-static-core
define:core = _FILE_OFFSET_BITS=64
define:core = _REENTRANT
cxxflag:core = -std=gnu++14
lib:uuid = yuni-static-uuid
dependency:uuid = core
lib:uuid = uuid
define:core = YUNI_LIBRARY_STATIC
